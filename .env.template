# Node environment
NODE_ENV=development

# Server
PORT=3000
FRONTEND_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX=100  # requests per window

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h

# MongoDB
MONGODB_URI=mongodb://localhost:27017/quickbooks-voice-invoice

# Encryption
ENCRYPTION_KEY=your_32_byte_encryption_key_here

# QuickBooks API
QB_CLIENT_ID=your_quickbooks_client_id_here
QB_CLIENT_SECRET=your_quickbooks_client_secret_here
QB_REDIRECT_URI=http://localhost:3000/auth/qbo/callback
QB_ENVIRONMENT=sandbox  # sandbox or production

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here